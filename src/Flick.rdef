resource app_signature "application/x-vnd.Flick";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Flick",
	long_info = "Flick, a simple camera app. Copyright 2026, Michael Spanier."
};
